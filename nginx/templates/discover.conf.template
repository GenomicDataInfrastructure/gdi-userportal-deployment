upstream discover {
    server frontend:3000;
}

server {
    server_name  ${DISCOVER_HOSTNAME};

    listen 80;
    listen [::]:80;

    set_real_ip_from 0.0.0.0/0;
    real_ip_header X-Real-IP;
    real_ip_recursive on;

    # CVE-2026-111497: nothing in the stack accepts Brotli request bodies.
    if ($http_content_encoding ~* "br") {
        return 415;
    }

    location / {
        proxy_pass http://discover;
        
        proxy_redirect off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port 80;
        # Next.js checks Server Actions' Origin against X-Forwarded-Host; $http_host keeps a
        # non-default port (e.g. a local run on :8088), where $host would drop it.
        proxy_set_header X-Forwarded-Host $http_host;
    }
}
