# Copy to .env.secrets and fill in. Values here override .env and .env.keycloak.
# postgres reads the KC_DB_* values to create Keycloak's database (2_create_keycloakdb.sh);
# keycloak reads them to connect to it.
KC_DB_NAME=keycloakdb
KC_DB_USERNAME=keycloakdbuser
KC_DB_PASSWORD=
# Keycloak's initial admin (the user name is KEYCLOAK_ADMIN in .env.keycloak).
KEYCLOAK_ADMIN_PASSWORD=
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
# REMS API key used by access-management-service and the synchronizer (same value for both).
# Register it in REMS once: docker compose run --rm -e CMD="api-key add <key> userportal" rems
REMS_API_KEY=
QUARKUS_REST_CLIENT_REMS_YAML_API_KEY=
# Frontend session encryption (next-auth): any long random string, e.g. `openssl rand -base64 32`.
NEXTAUTH_SECRET=
